<?xml version="1.0" encoding="UTF-8"?>
<!-- Keyline CG Studio control panel for Ross DashBoard (CustomPanel). Generated 2026-11-01T15:41:28.869Z for project "Sample Project".
     Open in DashBoard: File > Open, or drop into a CustomPanel folder. Sends RossTalk to Keyline (default TCP 7788). -->
<abs contexttype="opengear" id="_top" keepalive="false" style="bg#2b2f36;" width="1040" height="590">
   <meta>
      <params>
         <param access="1" maxlength="0" name="Keyline Host" oid="keyline_host" type="STRING" value="127.0.0.1" widget="text"/>
         <param access="1" constrainttype="INT_NULL" name="Keyline RossTalk Port" oid="keyline_port" precision="0" type="INT32" value="7788" widget="default"/>
      </params>
   </meta>
   <label height="30" left="20" name="KEYLINE CG STUDIO · Sample Project" style="txt-align:west;font:bold;size:Bigger;fg#ffffff;" top="10" width="600"/>
   <label height="24" left="20" name="Host" style="txt-align:west;fg#cccccc;" top="48" width="40"/>
   <param expand="true" height="26" left="64" oid="keyline_host" top="46" width="200"/>
   <label height="24" left="280" name="Port" style="txt-align:west;fg#cccccc;" top="48" width="40"/>
   <param expand="true" height="26" left="320" oid="keyline_port" top="46" width="90"/>
   <button buttontype="push" height="60" left="20" name="TAKE NEXT" style="bg#dd2222;txt-align:center;" top="90" width="150">
