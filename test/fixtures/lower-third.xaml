<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1920" Height="1080">
  <Canvas>
    <Rectangle x:Name="Bar" Canvas.Left="100" Canvas.Top="850" Width="1200" Height="120" Fill="#E6102030" RadiusX="6"/>
    <TextBlock x:Name="Headline" Canvas.Left="130" Canvas.Top="860" Width="1100" Height="60" Text="Headline goes here" FontFamily="Arial" FontSize="48" FontWeight="Bold" Foreground="#FFFFFFFF"/>
    <TextBlock Name="Description" Canvas.Left="130" Canvas.Top="920" Width="1100" Height="40" FontSize="30" Foreground="#FFCCCCCC">Description text</TextBlock>
    <Image Name="Logo" Canvas.Left="1320" Canvas.Top="850" Width="120" Height="120" Source="logo.png"/>
    <Grid Margin="1500,60,0,0" Width="300" Height="80" Background="#FFD4141C">
      <TextBlock Name="Bug" Margin="20,10,0,0" Width="260" Height="60" Text="LIVE" FontSize="44" Foreground="White" TextAlignment="Center"/>
    </Grid>
  </Canvas>
</UserControl>
